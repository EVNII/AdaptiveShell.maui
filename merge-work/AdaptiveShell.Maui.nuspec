<?xml version='1.0' encoding='utf-8'?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AdaptiveShell.Maui</id>
    <version>0.2.0</version>
    <authors>EVNII</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/EVNII/AdaptiveShell.maui</projectUrl>
    <description>Adaptive shell navigation for .NET MAUI: sidebar, rail and bottom navigation that adapt to platform, window size and navigation groups.</description>
    <tags>maui navigation shell adaptive sidebar</tags>
    <repository type="git" url="https://github.com/EVNII/AdaptiveShell.maui" commit="352e89ffb5021665e395259c58670b33acaaceb6" />
    <dependencies>
      <group targetFramework="net10.0-android36.0">
        <dependency id="Microsoft.Maui.Controls" version="10.0.100" exclude="Build,Analyzers" />
        <dependency id="Xamarin.Google.Android.Material" version="1.14.0.6" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-ios26.5">
        <dependency id="Microsoft.Maui.Controls" version="10.0.100" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-maccatalyst26.5">
        <dependency id="Microsoft.Maui.Controls" version="10.0.100" exclude="Build,Analyzers" />
      </group>
    <group targetFramework="net10.0-windows10.0.19041.0"><dependency id="Microsoft.Maui.Controls" version="10.0.100" exclude="Build,Analyzers" />
      </group></dependencies>
  </metadata>
</package>