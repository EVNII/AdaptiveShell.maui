<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios26.5;net10.0-maccatalyst26.5</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Opt in to the .NET Apple SDK's Xcode 26.5 preview bindings (if available). -->
		<NoWarn Condition="'$(TargetFramework)' == 'net10.0-ios26.5' Or '$(TargetFramework)' == 'net10.0-maccatalyst26.5'">$(NoWarn);XCODE_26_5_PREVIEW</NoWarn>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>


		<DefaultItemExcludes>
			$(DefaultItemExcludes);Example\**\*
		</DefaultItemExcludes>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- NuGet package metadata -->
		<PackageId>AdaptiveShell.Maui</PackageId>
		<Version>0.1.1</Version>
		<Authors>EVNII</Authors>
		<Description>Adaptive shell navigation for .NET MAUI: sidebar, rail and bottom navigation that adapt to platform, window size and navigation groups.</Description>
		<PackageTags>maui;navigation;shell;adaptive;sidebar</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/EVNII/AdaptiveShell.maui</PackageProjectUrl>
		<RepositoryUrl>https://github.com/EVNII/AdaptiveShell.maui</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- XML documentation file, packed next to each assembly for IDE code completion. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>

		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">18.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<Compile Remove="**\*.Android.cs" />
		<None Include="**\*.Android.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'">
		<Compile Remove="**\*.MaciOS.cs" />
		<None Include="**\*.MaciOS.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-windows')) != true">
		<Compile Remove="**\*.Windows.cs" />
		<None Include="**\*.Windows.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidResource Include="Resources\Drawable\material_symbols_menu_24.xml" />
		<AndroidResource Include="Resources\Drawable\material_symbols_menu_open_24.xml" />
		<AndroidResource Include="Resources\Drawable\material_symbols_arrow_back_24.xml" />
	</ItemGroup>

	<Target Name="DownloadMaterialMenuSymbols" BeforeTargets="_ComputeAndroidResourcePaths" Condition="!Exists('$(MSBuildProjectDirectory)\Resources\Drawable\material_symbols_menu_24.xml')">
		<DownloadFile SourceUrl="https://raw.githubusercontent.com/google/material-design-icons/310de998d61fc253a6df21e708a54c1d18338cab/symbols/android/menu/materialsymbolsoutlined/menu_24px.xml" DestinationFolder="$(MSBuildProjectDirectory)\Resources\Drawable\" DestinationFileName="material_symbols_menu_24.xml" />
	</Target>

	<Target Name="DownloadMaterialMenuOpenSymbols" BeforeTargets="_ComputeAndroidResourcePaths" Condition="!Exists('$(MSBuildProjectDirectory)\Resources\Drawable\material_symbols_menu_open_24.xml')">
		<DownloadFile SourceUrl="https://raw.githubusercontent.com/google/material-design-icons/310de998d61fc253a6df21e708a54c1d18338cab/symbols/android/menu_open/materialsymbolsoutlined/menu_open_24px.xml" DestinationFolder="$(MSBuildProjectDirectory)\Resources\Drawable\" DestinationFileName="material_symbols_menu_open_24.xml" />
	</Target>

	<Target Name="DownloadMaterialArrowBackSymbols" BeforeTargets="_ComputeAndroidResourcePaths" Condition="!Exists('$(MSBuildProjectDirectory)\Resources\Drawable\material_symbols_arrow_back_24.xml')">
		<DownloadFile SourceUrl="https://raw.githubusercontent.com/google/material-design-icons/310de998d61fc253a6df21e708a54c1d18338cab/symbols/android/arrow_back/materialsymbolsoutlined/arrow_back_24px.xml" DestinationFolder="$(MSBuildProjectDirectory)\Resources\Drawable\" DestinationFileName="material_symbols_arrow_back_24.xml" />
	</Target>

</Project>
